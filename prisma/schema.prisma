// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model Pokemon {
  id             Int      @id
  name           String   @unique
  nameFr         String?    // nom officiel français, nullable
  image          String?    // nullable, sprite animé (Showdown), peut être absent
  defaultImage   String?    // nullable, sprite statique de secours si `image` est absent/invalide
  height         Int?       // nullable
  weight         Int?       // nullable
  cry            String?    // nullable
  types          String[]    // array de chaînes (non nullable)
  hp             Int?       // stats de base, nullable
  attack         Int?
  defense        Int?
  specialAttack  Int?
  specialDefense Int?
  speed          Int?
  moves          Json?      // 4 attaques offensives max, précalculées pour le combat
}

model User {
  id  String  @id @default(cuid())
  username String @unique
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams Team[]
}

model Types {
  id  String @id @default(cuid())
  name String
  number Int
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String?
  pokemons  String[]
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model NpcTeam {
  id         Int      @id @default(autoincrement())
  name       String
  difficulty String   // easy | medium | hard
  pokemons   String[]
}
