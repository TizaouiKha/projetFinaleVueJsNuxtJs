# Copy this file to .env and update the values to match your local setup.
# The Prisma schema targets PostgreSQL (see prisma/schema.prisma) - see the README for a docker run command.
DATABASE_URL="postgresql://pokemon:pokemon@localhost:5432/pokemon?schema=public"

# Session secrets used by nuxt-oidc-auth. Generate with: openssl rand -hex 32
NUXT_OIDC_SESSION_SECRET=""
NUXT_OIDC_AUTH_SESSION_SECRET=""

# GitHub OAuth App credentials (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:3000/auth/github/callback
CLIENT_ID=""
CLIENT_SECRET=""